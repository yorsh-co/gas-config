{
  "name": "gas-config",
  "version": "2.3.0",
  "private": true,
  "description": "A settings UI for Google Apps Script projects.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yorsh-co/gas-config"
  },
  "author": "Joshua Porter",
  "license": "MIT",
  "yorsh": {
    "organization": "Yorsh",
    "homepage": "https://yorsh.co"
  },
  "engines": {
    "node": "^22.15.0 || ^24.0.0 || >=26.0.0"
  },
  "type": "module",
  "prettier": "gasdev/prettier",
  "gasdev": {
    "loadOrder": [
      "types/gas-config.types.ts",
      "shared/gas-config.contract.types.ts",
      "shared/gas-config.validation.ts",
      "generated/gas-config.ui.html.ts",
      "gas-config.errors.ts",
      "gas-config.storage.ts",
      "gas-config.access.ts",
      "gas-config.class.ts",
      "gas-config.ui.ts"
    ],
    "peers": {
      "gas-lock": "^1.2.5",
      "gas-error": "^1.2.6",
      "gas-logger": "^2.0.5"
    },
    "html": [
      {
        "entry": "src/web/gas-config.ui.html",
        "out": "src/generated/gas-config.ui.html.ts",
        "name": "_GAS_CONFIG_UI_HTML"
      }
    ],
    "gasTest": {
      "scopes": [
        "https://www.googleapis.com/auth/script.storage",
        "https://www.googleapis.com/auth/userinfo.email"
      ]
    },
    "release": {
      "githubRelease": true
    }
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@playwright/test": "~1.65.0",
    "@types/google-apps-script": "^2.0.15",
    "@types/node": "^26.6.6",
    "eslint": "^10.7.0",
    "gasdev": "github:yorsh-co/gasdev#semver:^3.1.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "gaxios": "^7.3.1"
  },
  "scripts": {
    "clean": "rimraf dist",
    "release": "gasdev release",
    "build": "npm run clean && npm run build:frontend && npm run build:backend",
    "build:fonts": "node scripts/build-fonts.js",
    "build:frontend": "node scripts/build-fonts.js --check && gasdev html",
    "build:backend": "tsc -p tsconfig.json",
    "build:format": "npm run check && npm run build && npm run format:dist",
    "build:watch": "trap \"trap - INT TERM; kill 0\" INT TERM; tsc -p tsconfig.json --watch --preserveWatchOutput & tsc -p tsconfig.frontend.json --watch --preserveWatchOutput & wait",
    "build:release": "npm run build:format && npm run release",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend && npm run typecheck:test && npm run typecheck:peer && npm run typecheck:e2e && npm run typecheck:gas-test",
    "typecheck:backend": "tsc -p tsconfig.json --noEmit && echo \"✓ TypeScript passed (backend)\"",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json && echo \"✓ TypeScript passed (frontend)\"",
    "typecheck:test": "tsc -p tsconfig.test.json && echo \"✓ TypeScript passed (test)\"",
    "typecheck:peer": "tsc -p tsconfig.peer.json && echo \"✓ TypeScript passed (peer)\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json && echo \"✓ TypeScript passed (e2e)\"",
    "typecheck:gas-test": "tsc -p gas-test/tsconfig.json --noEmit && echo \"✓ TypeScript passed (gas-test)\"",
    "lint": "eslint . && echo '✓ Lint passed'",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:dist": "prettier ./dist --write --ignore-path .prettierignore",
    "format:check": "prettier . --check",
    "peers:sync": "gasdev peers sync",
    "peers:check": "gasdev peers sync --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && gasdev check",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node dev/serve.js",
    "test:e2e": "playwright test",
    "test:gas:build": "gasdev gas-test build",
    "test:gas": "gasdev gas-test run",
    "manual:build": "npm run build && node scripts/build-manual-config.js"
  }
}
